# Public build-time values only. Copy this file to client/.env.local.
# Never put database, AI-provider, Cloudinary, JWT, or OAuth-client-secret values here.
VITE_API_URL="http://localhost:4000/api"
# Google sign-in reads the public client ID from the API at runtime. Configure
# GOOGLE_CLIENT_ID only in server/.env; no duplicate client value is required.
