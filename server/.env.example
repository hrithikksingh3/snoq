# Server-only secrets and configuration. Copy this file to server/.env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
COOKIE_SECURE=false
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"
PORT=4000

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="resource-vault/documents"
CLOUDINARY_AVATAR_FOLDER="snoq/avatars"

RESEND_API_KEY=""
EMAIL_FROM="SNOQ <noreply@yourdomain.com>"

# The matching account is promoted to administrator on sign-in.
ADMIN_EMAIL="owner@yourdomain.com"
# Keep these server-side only. Each paid plan needs its Razorpay plan ID in Admin.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional SMS broadcast support for admin coupon announcements.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="openrouter"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-3.5-flash-lite"

# Per-IP limits. Keep these conservative for internet-facing deployments.
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_MAX=20
CHECKOUT_RATE_LIMIT_MAX=10
PUBLIC_ACCESS_REQUEST_RATE_LIMIT_MAX=10
BROADCAST_RATE_LIMIT_MAX=3
REPORT_RATE_LIMIT_MAX=20
USER_EXPORT_RATE_LIMIT_MAX=5
